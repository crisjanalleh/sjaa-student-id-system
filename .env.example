# ---------------------------------------------------------------------------
# SJAA Student ID Issuance System — environment template (SAFE EXAMPLE VALUES)
# Copy to .env and fill in real values. NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# MySQL/MariaDB connection (XAMPP defaults: user root, no password)
DATABASE_URL=mysql://root@127.0.0.1:3306/sjaa_id_system

APP_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Manila
# 64+ hex characters — generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS

# Secret required by the one-time first-run /setup page (or leave empty to
# force CLI-only admin creation). Generate with the same command above.
SETUP_SECRET=

# true ONLY when deployed behind a trusted reverse proxy that sets
# X-Forwarded-For correctly. Otherwise leave false so spoofed headers cannot
# evade rate limits.
TRUSTED_PROXY=false

# Admin session hardening
SESSION_IDLE_TIMEOUT=30      # minutes of inactivity before forced re-login
SESSION_ABSOLUTE_TIMEOUT=12  # hours, regardless of activity

# Public access token + upload + rate limit policy
PUBLIC_TOKEN_DEFAULT_TTL=30  # days for new QR access tokens
MAX_UPLOAD_MB=5              # hard application limit for student photos
RATE_LIMIT_SUBMISSIONS_PER_HOUR=3

# SMTP (Nodemailer transport). Optional for local testing.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls          # tls (STARTTLS) or ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=San Jose Adventist Academy

# Optional: override the privacy notice text on the public application form.
# Keep it factual; do not hard-code retention periods unless approved.
PRIVACY_NOTICE=
